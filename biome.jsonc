{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!packages/shared/drizzle",
      // Generated by `pnpm api:spec` and asserted byte for byte by `pnpm api:spec:check`, the
      // same treatment drizzle's migrations get above. Two formatters over one file is a fight
      // nobody wins: Biome rewrapping a long union made the freshly generated file "stale".
      "!apps/frontend/src/lib/api/types.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Direct conflict with TypeScript's `noPropertyAccessFromIndexSignature`, which
        // F1.1 strictness turns on: TS REQUIRES `process.env['MC_PORT']`, this rule
        // demands `process.env.MC_PORT`. The compiler wins.
        "useLiteralKeys": "off"
      },
      "suspicious": {
        // TDS 07 §11.2: no `test.only` / `describe.only` may reach a PR.
        "noFocusedTests": "error",
        "noSkippedTests": "warn"
      },
      "style": {
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
