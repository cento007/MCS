# Mission Control — bootstrap configuration
# =========================================
# Copy to `.env` at the REPOSITORY ROOT and fill in. One file, all four processes
# (TDS 02 §8.2: single root .env; per-app .env files do not exist).
#
# This file holds the COMPLETE bootstrap set (TDS F8.2). Nothing else belongs here:
# every other setting — GitHub, Claude Code, Telegram, Obsidian, Qdrant, Ollama,
# notifications, memory, agents, security policy — lives in the `settings` table and
# is edited only through the Settings page. Secrets live in `secret_items`, encrypted
# with MC_ENCRYPTION_KEY below.
#
# Precedence: real process environment wins over values in this file (12-factor).
# In production the same variable set is delivered by systemd
# (EnvironmentFile=/etc/mission-control/mission-control.env — see deploy/systemd/).
#
# NEVER commit a filled-in .env — it is git-ignored. This example carries no real values.

# PostgreSQL connection string. Required — there is no default and no fallback store.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://mission_control:CHANGE_ME@127.0.0.1:5432/mission_control

# Backend listen address (TDS 02 §1.1). Defaults: 127.0.0.1 / 8710.
# Set MC_HOST=0.0.0.0 only if you deliberately want the dashboard reachable from the LAN.
MC_HOST=127.0.0.1
MC_PORT=8710

# 32-byte key, base64-encoded, for AES-256-GCM encryption of `secret_items` (TDS 03 §3.13).
# Required. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back this up OUT OF BAND (password manager). Losing it makes every stored secret
# unrecoverable by design; changing it requires a re-encryption pass (key_version).
MC_ENCRYPTION_KEY=

# Root directory for app-owned files: exports/, hooks/, tmp/ (TDS 02 §1.2).
# Optional — omit to use the platform default:
#   Windows : %LOCALAPPDATA%\MissionControl
#   macOS   : ~/Library/Application Support/MissionControl
#   Linux   : $XDG_DATA_HOME/mission-control (or ~/.local/share/mission-control)
# Production (Ubuntu) sets this explicitly to /var/lib/mission-control.
# Must be an ABSOLUTE native path when set.
# MC_DATA_DIR=

# development | test | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
