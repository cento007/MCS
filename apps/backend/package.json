{
  "name": "@mc/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mission Control Backend — Fastify 5 API, auth, session manager, WebSocket hub (TDS 02 §2)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "auth:create-user": "tsx src/cli/create-user.ts",
    "hooks": "tsx src/cli/hooks.ts",
    "api:spec": "tsx src/cli/openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@fastify/websocket": "11.3.0",
    "@mc/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/ws": "8.18.1",
    "pg-boss": "12.27.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "ws": "8.21.3"
  }
}
